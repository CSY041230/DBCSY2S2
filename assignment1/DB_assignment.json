    {
        "id": "1a0a16f3bc5b1b39",
        "type": "function",
        "z": "a019262604d3b48e",
        "name": "Verify and send",
        "func": "if (msg.payload) {\n\n    const data = msg.originalPayload;\n\n    msg.payload = {\n        timestamp: new Date(),\n        deviceId: data.deviceId,\n        distance: data.distance,\n        irDetected: data.irDetected,\n        ledState: data.ledState,\n        alarmStatus: (data.distance < 30)\n            ? (data.irDetected ? \"ACTIVE\" : \"WARNING\")\n            : \"SAFE\"\n    };\n\n    return msg;\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
