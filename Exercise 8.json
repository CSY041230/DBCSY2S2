    {
        "id": "b99cc013c386eb4f",
        "type": "function",
        "z": "6a65712536e58415",
        "name": "parse mqtt",
        "func": "//1. Capture the raw MQTT telemetry\nvar raw_data = msg.payload;\n\n//2. Construct the Time-Series compliant object\nvar ts_document = {\n    \"timestamp\": new Date(),    //Must match your Atlas time\n    \"sensor_id\": raw_data.sensor_id,\n    \"temperature\": raw_data.temperature,\n    \"humidity\": raw_data.humidity\n};\n\n//3. Pass the formatted document forward\nmsg.payload = ts_document;\nreturn msg;",
